  <div class="rv-sticky-bar__inner">
    <span class="rv-sticky-bar__price">{{ current_variant.price | money }}</span>
    <button class="rv-sticky-bar__btn" onclick="document.querySelector('.rv-btn-cart').click()">ADD TO CART</button>
