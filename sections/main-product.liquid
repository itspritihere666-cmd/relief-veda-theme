{%- comment -%}--- ALL JS ---{%- endcomment -%}
<script>
  /* === Gallery === */
  function rvSwitchImage(el, direction) {
    var src = el.getAttribute('data-full-src');
    var zoomSrc = el.getAttribute('data-zoom-src') || src;
    var alt = el.getAttribute('data-alt') || '';
    var img = document.getElementById('rv-featured-img');
    if (!img || !src) return;

    if (direction) {
      var outClass = direction === 'next' ? 'rv-slide-left' : 'rv-slide-right';
      var inClass = direction === 'next' ? 'rv-slide-right' : 'rv-slide-left';
      img.classList.add(outClass);
      setTimeout(function() {
        img.src = src; img.alt = alt; img.setAttribute('data-zoom-src', zoomSrc);
        img.classList.remove(outClass);
        img.classList.add(inClass);
        img.offsetHeight;
        img.classList.remove(inClass);
      }, 200);
    } else {
      img.src = src; img.alt = alt; img.setAttribute('data-zoom-src', zoomSrc);
    }

    document.querySelectorAll('.rv-gallery__thumb, .rv-gallery__dot').forEach(function(t) { t.classList.remove('is-active'); });
    var mid = el.getAttribute('data-media-id');
    document.querySelectorAll('[data-media-id="' + mid + '"]').forEach(function(t) { t.classList.add('is-active'); });
  }

  function rvNavigateImage(delta) {
    var dots = Array.prototype.slice.call(document.querySelectorAll('.rv-gallery__dot'));
    if (dots.length === 0) dots = Array.prototype.slice.call(document.querySelectorAll('.rv-gallery__thumb'));
    if (dots.length < 2) return;
    var cur = 0;
    dots.forEach(function(d, i) { if (d.classList.contains('is-active')) cur = i; });
    var next = cur + delta;
    if (next < 0) next = dots.length - 1;
    if (next >= dots.length) next = 0;
    rvSwitchImage(dots[next], delta > 0 ? 'next' : 'prev');
  }

  /* Swipe */
  (function() {
    var g = document.querySelector('.rv-gallery__main');
    if (!g) return;
    var sx = 0, sy = 0, tracking = false;
    g.addEventListener('touchstart', function(e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; tracking = true; }, { passive: true });
    g.addEventListener('touchmove', function(e) {
      if (!tracking) return;
      if (Math.abs(e.touches[0].clientX - sx) > Math.abs(e.touches[0].clientY - sy) && Math.abs(e.touches[0].clientX - sx) > 10) e.preventDefault();
    }, { passive: false });
    g.addEventListener('touchend', function(e) {
      if (!tracking) return; tracking = false;
      var diff = e.changedTouches[0].clientX - sx;
      if (Math.abs(diff) < 40) return;
      rvNavigateImage(diff < 0 ? 1 : -1);
    }, { passive: true });
  })();

  /* === Quantity with price update === */
  function rvQty(delta) {
    var input = document.getElementById('rv-qty');
    if (!input) return;
    var val = Math.max(1, (parseInt(input.value, 10) || 1) + delta);
    input.value = val;
    rvUpdatePrice(val);
  }

  function rvFormatMoney(cents) {
    var amt = (cents / 100).toFixed(2);
    return '{{ cart.currency.symbol | default: "Rs." }} ' + amt.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function rvUpdatePrice(qty) {
    var bp = document.getElementById('rv-btn-price');
    if (bp) { bp.textContent = rvFormatMoney(parseInt(bp.getAttribute('data-unit-price'), 10) * qty); }
    var mp = document.querySelector('.rv-price__current');
    if (mp && mp.getAttribute('data-unit-price')) { mp.textContent = rvFormatMoney(parseInt(mp.getAttribute('data-unit-price'), 10) * qty); }
    var mc = document.querySelector('.rv-price__compare');
    if (mc && mc.getAttribute('data-unit-compare')) { mc.textContent = rvFormatMoney(parseInt(mc.getAttribute('data-unit-compare'), 10) * qty); }
  }

  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('rv-qty');
    if (input) {
      input.addEventListener('change', function() {
        var v = parseInt(this.value, 10);
        if (isNaN(v) || v < 1) { v = 1; this.value = 1; }
        rvUpdatePrice(v);
      });
    }
  });

  /* === Description toggle === */
  function rvToggleDesc() {
    var t = document.getElementById('rv-desc-text');
    var b = document.getElementById('rv-desc-toggle');
    if (!t) return;
    if (t.classList.contains('is-collapsed')) {
      t.classList.remove('is-collapsed');
      t.style.maxHeight = t.scrollHeight + 'px';
      if (b) { b.innerHTML = 'Read less <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>'; b.classList.add('is-open'); }
    } else {
      t.classList.add('is-collapsed');
      t.style.maxHeight = '';
      if (b) { b.innerHTML = 'Read more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>'; b.classList.remove('is-open'); }
    }
  }

  /* === FAQ accordion === */
  function rvToggleFaq(el) {
    var isOpen = el.classList.contains('is-open');
    /* Close all */
    document.querySelectorAll('.rv-faq').forEach(function(f) {
      f.classList.remove('is-open');
      var trigger = f.querySelector('.rv-faq__trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
    /* Open clicked if it wasn't open */
    if (!isOpen) {
      el.classList.add('is-open');
      var trigger = el.querySelector('.rv-faq__trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
    }
  }

  /* === Variant selector === */
  function rvSelectVariant(el, variantId) {
    if (el.classList.contains('is-soldout')) return;
    document.querySelectorAll('.rv-variant-chip').forEach(function(c) { c.classList.remove('is-selected'); });
    el.classList.add('is-selected');
    var idInput = document.getElementById('rv-variant-id');
    if (idInput) idInput.value = variantId;
    if (window.history && window.history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', url.toString());
    }
    document.dispatchEvent(new CustomEvent('variant:changed', { detail: { variantId: variantId } }));
  }

  /* === Toast === */
  var rvToastTimer = null;
  function rvShowToast() {
    var toast = document.getElementById('rv-cart-toast');
    if (!toast) return;
    var bar = document.getElementById('rv-toast-bar');
    if (bar) { bar.style.animation = 'none'; bar.offsetHeight; bar.style.animation = ''; }
    toast.classList.add('is-visible');
    clearTimeout(rvToastTimer);
    rvToastTimer = setTimeout(rvHideToast, 3500);
  }
  function rvHideToast() {
    var toast = document.getElementById('rv-cart-toast');
    if (toast) toast.classList.remove('is-visible');
    clearTimeout(rvToastTimer);
  }

  /* ATC intercept */
  (function() {
    var form = document.querySelector('.rv-section .ProductForm');
    if (!form) return;
    var btn = form.querySelector('.ProductForm__AddToCart');
    var originalHTML = btn ? btn.innerHTML : '';
    form.addEventListener('submit', function() {
      if (!btn || (btn.disabled && !btn.classList.contains('is-added'))) return;
      btn.classList.add('is-added');
      btn.innerHTML = '<span>&#10003; ADDED</span>';
      rvShowToast();
      setTimeout(function() { btn.classList.remove('is-added'); btn.innerHTML = originalHTML; }, 2500);
    });
  })();

  /* === Image Zoom === */
  (function() {
    var container = document.querySelector('.rv-gallery__main');
    var lens = document.getElementById('rv-zoom-lens');
    var img = document.getElementById('rv-featured-img');
    if (!container || !lens || !img) return;

    var isMobile = window.matchMedia('(max-width: 991px)').matches;

    /* Desktop: lens zoom on hover */
    if (!isMobile) {
      container.addEventListener('mouseenter', function() {
        var zoomSrc = img.getAttribute('data-zoom-src') || img.src;
        lens.style.backgroundImage = 'url(' + zoomSrc + ')';
        /* Magnify ~2.2x the displayed image (not the lens) so it actually zooms in */
        lens.style.backgroundSize = (container.offsetWidth * 2.2) + 'px auto';
        lens.classList.add('is-active');
      });

      container.addEventListener('mousemove', function(e) {
        var rect = container.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var lw = lens.offsetWidth / 2;
        var lh = lens.offsetHeight / 2;

        /* Clamp lens position */
        var lx = Math.max(lw, Math.min(x, rect.width - lw));
        var ly = Math.max(lh, Math.min(y, rect.height - lh));

        lens.style.left = lx - lw + 'px';
        lens.style.top = ly - lh + 'px';

        /* Background position for magnified image */
        var px = (x / rect.width) * 100;
        var py = (y / rect.height) * 100;
        lens.style.backgroundPosition = px + '% ' + py + '%';
      });

      container.addEventListener('mouseleave', function() {
        lens.classList.remove('is-active');
      });
    }

    /* Open fullscreen: tap on mobile, double-click on desktop */
    function rvOpenFullscreen() {
      var overlay = document.getElementById('rv-zoom-overlay');
      var overlayImg = document.getElementById('rv-zoom-overlay-img');
      if (!overlay || !overlayImg) return;
      overlayImg.src = img.getAttribute('data-zoom-src') || img.src;
      overlayImg.alt = img.alt;
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      lens.classList.remove('is-active');
    }

    container.addEventListener('click', function() {
      if (isMobile) rvOpenFullscreen();
    });

    container.addEventListener('dblclick', function() {
      if (!isMobile) rvOpenFullscreen();
    });

    /* Recheck on resize */
    window.addEventListener('resize', function() {
      isMobile = window.matchMedia('(max-width: 991px)').matches;
    });
  })();

  /* Close fullscreen zoom */
  function rvCloseZoom(e) {
    var overlay = document.getElementById('rv-zoom-overlay');
    if (!overlay) return;
    /* Only close if clicking overlay bg or close button, not the image */
    if (e.target === overlay || e.target.closest('.rv-zoom-overlay__close')) {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  }

  /* Close on Escape key */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var overlay = document.getElementById('rv-zoom-overlay');
      if (overlay && overlay.classList.contains('is-open')) {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }
  });
</script>

{% schema %}
{
  "name": "Product page",
  "class": "shopify-section--bordered",
  "blocks": [
    {
      "type": "product_meta",
      "name": "Product meta",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_sku",
          "label": "Show SKU",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_product_rating",
          "label": "Show product rating",
          "info": "To display a rating, add a product rating app. [Learn more](https://help.shopify.com/en/manual/products/product-reviews/installation)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_taxes_included",
          "label": "Show price taxes notice",
          "default": false
        }
      ]
    },
    {
      "type": "variant_selector",
      "name": "Variant selector",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "selector_mode",
          "label": "Selector type",
          "options": [
            { "value": "block", "label": "Block" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "dropdown"
        },
        {
          "type": "checkbox",
          "id": "show_color_swatch",
          "label": "Show color swatch",
          "default": false,
          "info": "Some colors appear white? [Learn more](http://support.maestrooo.com/article/80-product-uploading-custom-color-for-color-swatch)."
        },
        {
          "type": "checkbox",
          "id": "show_color_carousel",
          "label": "Show color carousel",
          "info": "A pop-up selector with variant images for choosing colors. Only enables when color swatch is disabled.",
          "default": false
        },
        {
          "type": "page",
          "id": "size_chart",
          "label": "Size chart",
          "info": "Show along option named Size."
        }
      ]
    },
    { "type": "share_buttons", "name": "Share buttons", "limit": 1 },
    {
      "type": "inventory",
      "name": "Inventory",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "inventory_quantity_threshold",
          "label": "Inventory quantity threshold",
          "info": "Only show inventory quantity if below threshold. Choose 0 to always show.",
          "min": 0, "max": 50, "step": 1, "default": 0
        }
      ]
    },
    {
