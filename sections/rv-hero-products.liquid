{%- comment -%}
  Relief Veda — Hero Products Slideshow
  Full-bleed clickable banner slides. Each slide = uploaded image -> links to a
  product/collection page. Optional overlay headline + CTA button per slide.
  Self-contained. Drop in /sections/. Add via Theme Customizer. No deps.
{%- endcomment -%}

{%- liquid
  assign sec = section.id
  assign auto = section.settings.autoplay
  assign speed = section.settings.autoplay_speed | times: 1000
-%}

{%- style -%}
  .rvhp-{{ sec }}{
    position:relative;
    background: {{ section.settings.bg }};
    overflow:hidden;
  }
  .rvhp-{{ sec }} .rvhp__track{
    display:flex;
    transition: transform .55s cubic-bezier(.4,0,.2,1);
    will-change: transform;
  }
  .rvhp-{{ sec }} .rvhp__slide{
    position:relative;
    min-width:100%;
    flex:0 0 100%;
  }
  .rvhp-{{ sec }} .rvhp__link{
    display:block;
    position:relative;
    text-decoration:none;
    color:inherit;
  }
  .rvhp-{{ sec }} .rvhp__media{
    position:relative;
    width:100%;
    aspect-ratio: {{ section.settings.ratio_desktop }};
    background: {{ section.settings.bg }};
  }
  .rvhp-{{ sec }} .rvhp__media img{
    width:100%; height:100%;
    object-fit:cover; object-position:center;
    display:block;
  }
  .rvhp-{{ sec }} .rvhp__overlay{
    position:absolute; inset:0; z-index:2;
    display:flex; flex-direction:column;
    justify-content:center;
    padding: clamp(20px,5vw,72px);
    max-width:600px;
    pointer-events:none;
  }
  .rvhp-{{ sec }} .rvhp__overlay.is-right{ margin-left:auto; align-items:flex-end; text-align:right; }
  .rvhp-{{ sec }} .rvhp__overlay.is-center{ margin:0 auto; align-items:center; text-align:center; }
  .rvhp-{{ sec }} .rvhp__eyebrow{
    font-size:clamp(10px,1vw,13px); letter-spacing:.22em; text-transform:uppercase;
    font-weight:600; margin:0 0 14px;
  }
  .rvhp-{{ sec }} .rvhp__title{
    font-size:clamp(26px,4.6vw,56px); line-height:1.05; font-weight:700;
    letter-spacing:-.01em; margin:0 0 16px;
  }
  .rvhp-{{ sec }} .rvhp__btn{
    pointer-events:auto;
    display:inline-flex; align-items:center; gap:9px;
    background:{{ section.settings.btn_bg }}; color:{{ section.settings.btn_text }};
    padding:14px 30px; border-radius:{{ section.settings.btn_radius }}px;
    font-size:15px; font-weight:600; text-decoration:none;
    box-shadow:0 6px 22px rgba(0,0,0,.18);
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .rvhp-{{ sec }} .rvhp__btn:hover{ transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,0,0,.26); }
  .rvhp-{{ sec }} .rvhp__btn svg{ width:16px; height:16px; }

  /* arrows */
  .rvhp-{{ sec }} .rvhp__arrow{
    position:absolute; top:50%; transform:translateY(-50%);
    z-index:5; width:46px; height:46px; border-radius:50%;
    background:rgba(255,255,255,.92); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 4px 16px rgba(0,0,0,.18);
    transition:background .2s ease, transform .2s ease;
  }
  .rvhp-{{ sec }} .rvhp__arrow:hover{ background:#fff; transform:translateY(-50%) scale(1.06); }
  .rvhp-{{ sec }} .rvhp__arrow svg{ width:20px; height:20px; color:{{ section.settings.bg | default: '#2B1F14' }}; }
  .rvhp-{{ sec }} .rvhp__arrow svg path{ stroke:#2B1F14; }
  .rvhp-{{ sec }} .rvhp__arrow--prev{ left:clamp(10px,2vw,24px); }
  .rvhp-{{ sec }} .rvhp__arrow--next{ right:clamp(10px,2vw,24px); }

  /* dots */
  .rvhp-{{ sec }} .rvhp__dots{
    position:absolute; bottom:clamp(12px,2vw,22px); left:0; right:0; z-index:5;
    display:flex; gap:8px; justify-content:center;
  }
  .rvhp-{{ sec }} .rvhp__dot{
    width:9px; height:9px; border-radius:50%; border:none; cursor:pointer; padding:0;
    background:rgba(255,255,255,.55); transition:background .2s ease, width .2s ease;
  }
  .rvhp-{{ sec }} .rvhp__dot.is-active{ background:#fff; width:24px; border-radius:5px; }

  @media (max-width:749px){
    .rvhp-{{ sec }} .rvhp__media{ aspect-ratio: {{ section.settings.ratio_mobile }}; }
    .rvhp-{{ sec }} .rvhp__arrow{ width:38px; height:38px; }
    .rvhp-{{ sec }} .rvhp__overlay{ max-width:100%; }
  }
  @media (prefers-reduced-motion: reduce){
    .rvhp-{{ sec }} .rvhp__track{ transition:none; }
  }
{%- endstyle -%}

<section class="rvhp-{{ sec }}"
  data-rvhp
  data-auto="{{ auto }}"
  data-speed="{{ speed }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.title | default: 'Hero products' | escape }}">

  {%- if section.settings.heading != blank -%}
    <h2 style="text-align:center;font-size:clamp(22px,3vw,34px);font-weight:700;color:#2B1F14;margin:0;padding:clamp(24px,4vw,44px) 16px clamp(8px,1.5vw,18px);">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="rvhp__viewport">
    <div class="rvhp__track" data-rvhp-track>
      {%- for block in section.blocks -%}
        {%- assign img_m = block.settings.image_mobile | default: block.settings.image -%}
        <div class="rvhp__slide" {{ block.shopify_attributes }} role="group" aria-roledescription="slide">
          <a class="rvhp__link" href="{{ block.settings.link | default: '#' }}"
             {% if block.settings.link == blank %}aria-disabled="true"{% endif %}>
            <div class="rvhp__media">
              {%- if block.settings.image != blank -%}
                <picture>
                  {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width:749px)"
                    srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w"
                    sizes="100vw">
                  {%- endif -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 2000 }}"
                    srcset="{{ block.settings.image | image_url: width: 1000 }} 1000w,
                            {{ block.settings.image | image_url: width: 1600 }} 1600w,
                            {{ block.settings.image | image_url: width: 2000 }} 2000w,
                            {{ block.settings.image | image_url: width: 2600 }} 2600w"
                    sizes="100vw"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}>
                </picture>
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'rvhp__placeholder' }}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank or block.settings.btn_label != blank -%}
              <div class="rvhp__overlay is-{{ block.settings.align }}" style="color:{{ block.settings.text_color }};">
                {%- if block.settings.eyebrow != blank -%}<p class="rvhp__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                {%- if block.settings.title != blank -%}<p class="rvhp__title">{{ block.settings.title }}</p>{%- endif -%}
                {%- if block.settings.btn_label != blank -%}
                  <span class="rvhp__btn">
                    {{ block.settings.btn_label }}
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </a>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button class="rvhp__arrow rvhp__arrow--prev" data-rvhp-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="rvhp__arrow rvhp__arrow--next" data-rvhp-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="rvhp__dots" data-rvhp-dots>
        {%- for block in section.blocks -%}
          <button class="rvhp__dot{% if forloop.first %} is-active{% endif %}" data-rvhp-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var root = document.currentScript.closest('[data-rvhp]');
  if(!root) return;
  var track = root.querySelector('[data-rvhp-track]');
  var slides = track.children;
  var total = slides.length;
  if(total <= 1) return;
  var idx = 0, timer = null;
  var auto = root.getAttribute('data-auto') === 'true';
  var speed = parseInt(root.getAttribute('data-speed'),10) || 5000;
  var dots = root.querySelectorAll('[data-rvhp-dot]');

  function go(n){
    idx = (n + total) % total;
    track.style.transform = 'translateX(' + (-idx*100) + '%)';
    dots.forEach(function(d,i){ d.classList.toggle('is-active', i===idx); });
  }
  function next(){ go(idx+1); }
  function prev(){ go(idx-1); }
  function start(){ if(auto){ stop(); timer = setInterval(next, speed); } }
  function stop(){ if(timer){ clearInterval(timer); timer=null; } }

  var nx = root.querySelector('[data-rvhp-next]');
  var pv = root.querySelector('[data-rvhp-prev]');
  if(nx) nx.addEventListener('click', function(){ next(); start(); });
  if(pv) pv.addEventListener('click', function(){ prev(); start(); });
  dots.forEach(function(d){ d.addEventListener('click', function(){ go(parseInt(d.getAttribute('data-rvhp-dot'),10)); start(); }); });

  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);

  // swipe
  var x0=null, moved=false;
  track.addEventListener('touchstart', function(e){ x0=e.touches[0].clientX; moved=false; stop(); }, {passive:true});
  track.addEventListener('touchmove', function(e){
    if(x0!==null && Math.abs(e.touches[0].clientX - x0) > 10){ moved=true; }
  }, {passive:true});
  track.addEventListener('touchend', function(e){
    if(x0===null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if(Math.abs(dx) > 40){ dx<0 ? next() : prev(); }
    x0=null; start();
  }, {passive:true});

  // prevent ghost-click navigation after a swipe
  track.querySelectorAll('.rvhp__link').forEach(function(a){
    a.addEventListener('click', function(e){ if(moved){ e.preventDefault(); moved=false; } });
  });

  go(0); start();
})();
</script>

{% schema %}
{
  "name": "RV Hero Products",
  "tag": "section",
  "class": "rv-section rv-hero-products-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (optional)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFDF8" },
    { "type": "header", "content": "Slide shape" },
    { "type": "text", "id": "ratio_desktop", "label": "Desktop aspect ratio (e.g. 16/7)", "default": "16/7" },
    { "type": "text", "id": "ratio_mobile", "label": "Mobile aspect ratio (e.g. 4/5)", "default": "4/5" },
    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Seconds per slide", "default": 5 },
    { "type": "header", "content": "Default button style (per-slide button)" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#1F7A4D" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "btn_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button radius", "default": 8 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        { "type": "url", "id": "link", "label": "Links to (product / collection page)" },
        { "type": "header", "content": "Overlay text (optional)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "select", "id": "align", "label": "Text position",
          "options": [
            {"value":"left","label":"Left"},
            {"value":"center","label":"Center"},
            {"value":"right","label":"Right"}
          ], "default": "left" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
        { "type": "text", "id": "btn_label", "label": "Button label (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RV Hero Products",
      "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}

{% comment %}sync%{% endcomment %}
