{%- comment -%} Relief Veda — Ingredient / Efficacy Transparency {%- endcomment -%}
{%- style -%}
  .rv-ing-{{ section.id }}{ background:{{ section.settings.bg }}; padding: clamp(46px,6vw,84px) clamp(16px,4vw,40px); }
  .rv-ing-{{ section.id }} .rv-ing__head{ max-width:780px; margin:0 auto clamp(28px,4vw,46px); text-align:center; }
  .rv-ing-{{ section.id }} .rv-ing__eyebrow{ font-size:12px; letter-spacing:.2em; text-transform:uppercase; font-weight:600; color:{{ section.settings.accent }}; margin:0 0 10px; }
  .rv-ing-{{ section.id }} .rv-ing__title{ font-size: clamp(26px,3.6vw,42px); margin:0 0 12px; color:{{ section.settings.heading }}; font-weight:600; letter-spacing:-0.01em; }
  .rv-ing-{{ section.id }} .rv-ing__sub{ font-size: clamp(14px,1.4vw,17px); color:{{ section.settings.muted }}; line-height:1.55; margin:0; }
  .rv-ing-{{ section.id }} .rv-ing__grid{ max-width:1100px; margin:0 auto; display:grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: clamp(14px,1.8vw,24px); }
  .rv-ing-{{ section.id }} .rv-ing__card{ background:#fff; border:1px solid {{ section.settings.border }}; border-radius:16px; overflow:hidden; text-align:center; padding-bottom:18px; }
  .rv-ing-{{ section.id }} .rv-ing__media{ aspect-ratio:4/3; background:#F0E9DB; overflow:hidden; }
  .rv-ing-{{ section.id }} .rv-ing__media img{ width:100%;height:100%;object-fit:cover; }
  .rv-ing-{{ section.id }} .rv-ing__name{ font-size:17px; font-weight:600; margin:16px 0 6px; color:{{ section.settings.heading }}; }
  .rv-ing-{{ section.id }} .rv-ing__desc{ font-size:13.5px; color:{{ section.settings.muted }}; line-height:1.45; margin:0; padding:0 16px; }
  @media (max-width:749px){ .rv-ing-{{ section.id }} .rv-ing__grid{ grid-template-columns:repeat(2,1fr);} }
{%- endstyle -%}

<section class="rv-ing-{{ section.id }}">
  <div class="rv-ing__head">
    {%- if section.settings.eyebrow != blank -%}<p class="rv-ing__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="rv-ing__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="rv-ing__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>
  <div class="rv-ing__grid">
    {%- for block in section.blocks -%}
      <div class="rv-ing__card" {{ block.shopify_attributes }}>
        <div class="rv-ing__media">
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width:500 }}" alt="{{ block.settings.name | escape }}" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
        </div>
        <h3 class="rv-ing__name">{{ block.settings.name }}</h3>
        <p class="rv-ing__desc">{{ block.settings.desc }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RV Ingredients",
  "tag": "section",
  "class": "rv-section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7F2E9" },
    { "type": "color", "id": "heading", "label": "Heading", "default": "#2B1F14" },
    { "type": "color", "id": "muted", "label": "Muted", "default": "#6B5B4A" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1F7A4D" },
    { "type": "color", "id": "border", "label": "Border", "default": "#EAE0CD" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "text", "id": "title", "label": "Title", "default": "Pure herbs, potent extracts" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "We extract the active compounds from premium herbs — not raw powders — for consistent, effective results." },
    { "type": "range", "id": "cols", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 }
  ],
  "blocks": [
    { "type": "ing", "name": "Herb", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "name", "label": "Name", "default": "Gokhru" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Supports urinary tract & kidney health." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "RV Ingredients", "blocks": [ {"type":"ing"},{"type":"ing"},{"type":"ing"},{"type":"ing"} ] } ]
}
{% endschema %}

{% comment %}sync%{% endcomment %}
