{%- comment -%} Relief Veda — Offer Bar (sitewide, place at very top) {%- endcomment -%}
{%- style -%}
  .rv-bar-{{ section.id }}{ background:{{ section.settings.bg }}; color:{{ section.settings.text }}; overflow:hidden; }
  .rv-bar-{{ section.id }} .rv-bar__row{ display:flex; align-items:center; justify-content:center; gap:30px; padding:9px 16px; font-size:13px; font-weight:600; letter-spacing:.01em; flex-wrap:wrap; }
  .rv-bar-{{ section.id }} .rv-bar__item{ display:inline-flex; align-items:center; gap:7px; }
  .rv-bar-{{ section.id }} .rv-bar__item svg{ width:15px;height:15px;opacity:.9; }
  .rv-bar-{{ section.id }} a{ color:inherit; text-decoration:underline; text-underline-offset:2px; }
  @media (max-width:749px){
    .rv-bar-{{ section.id }}{ position:sticky; top:0; z-index:60; }
    .rv-bar-{{ section.id }} .rv-bar__row{ justify-content:center; gap:0; font-size:12px; padding:9px 12px; min-height:18px; }
    .rv-bar-{{ section.id }} .rv-bar__item{ display:none; }
    .rv-bar-{{ section.id }} .rv-bar__item.rv-on{ display:inline-flex; animation: rvbar-fade .5s ease; }
    @keyframes rvbar-fade{ from{ opacity:.15; transform:translateY(3px);} to{ opacity:1; transform:none; } }
  }
{%- endstyle -%}

{%- liquid
  assign ic_truck = '<svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.6" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17" r="1.6" stroke="currentColor" stroke-width="1.6"/></svg>'
  assign ic_cod = '<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg>'
  assign ic_tag = '<svg viewBox="0 0 24 24" fill="none"><path d="M3 12l9-9 9 9-9 9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="9" cy="9" r="1.2" fill="currentColor"/></svg>'
  assign ic_leaf = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 19c0-7 5-13 14-13 0 9-6 14-14 14z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 19c3-4 6-6 10-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
  assign ic_shield = '<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'
-%}

<section class="rv-bar-{{ section.id }}">
  <div class="rv-bar__row">
    {%- for block in section.blocks -%}
      <span class="rv-bar__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}{{ ic_truck }}
          {%- when 'cod' -%}{{ ic_cod }}
          {%- when 'tag' -%}{{ ic_tag }}
          {%- when 'leaf' -%}{{ ic_leaf }}
          {%- when 'shield' -%}{{ ic_shield }}
        {%- endcase -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</section>

<script>
(function(){
  function init(){
    var root = document.querySelector('.rv-bar-{{ section.id }}');
    if(!root) return;
    var items = [].slice.call(root.querySelectorAll('.rv-bar__item'));
    if(items.length < 2) return;
    var mq = window.matchMedia('(max-width:749px)');
    var i = 0, timer = null;
    function show(n){ items.forEach(function(el,j){ el.classList.toggle('rv-on', j===n); }); }
    function tick(){ i = (i+1) % items.length; show(i); }
    function start(){ stop(); if(mq.matches){ i = 0; show(0); timer = setInterval(tick, 3000); } else { items.forEach(function(el){ el.classList.remove('rv-on'); }); } }
    function stop(){ if(timer){ clearInterval(timer); timer = null; } }
    start();
    if(mq.addEventListener){ mq.addEventListener('change', start); } else if(mq.addListener){ mq.addListener(start); }
  }
  if(document.readyState !== 'loading'){ init(); }
  else { document.addEventListener('DOMContentLoaded', init); }
})();
</script>

{% schema %}
{
  "name": "RV Offer Bar",
  "tag": "section",
  "class": "rv-section rv-offer-bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1F7A4D" },
    { "type": "color", "id": "text", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "msg", "name": "Message", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ {"value":"none","label":"None"},{"value":"truck","label":"Truck"},{"value":"cod","label":"COD"},{"value":"tag","label":"Tag"},{"value":"leaf","label":"Leaf"},{"value":"shield","label":"Shield"} ], "default": "tag" },
      { "type": "text", "id": "text", "label": "Text", "default": "Launch Offer — Up to 50% Off" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "RV Offer Bar", "blocks": [
    {"type":"msg","settings":{"icon":"tag","text":"Launch Offer — Up to 50% Off"}},
    {"type":"msg","settings":{"icon":"truck","text":"Free shipping over Rs. 499"}},
    {"type":"msg","settings":{"icon":"cod","text":"Cash on Delivery available"}}
  ] } ]
}
{% endschema %}

{% comment %}sync%{% endcomment %}
