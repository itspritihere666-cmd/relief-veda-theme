{%- comment -%} Relief Veda — minimal scroll reveal (fade-up + stagger). Additive, safe. {%- endcomment -%}
<style>
  html.rv-anim [data-rvr]{ opacity:0; transform:translateY(22px); will-change:opacity,transform; }
  html.rv-anim [data-rvr].rvr-in{
    opacity:1; transform:none;
    transition:opacity .65s ease, transform .65s cubic-bezier(.22,.61,.36,1);
  }
  @media (prefers-reduced-motion: reduce){
    html.rv-anim [data-rvr]{ opacity:1 !important; transform:none !important; transition:none !important; }
  }

  /* --- Footer: minimal / compact (desktop + mobile) --- */
  .Footer{ padding-top:34px !important; padding-bottom:18px !important; }
  .Footer .Footer__Inner{ gap:26px !important; }
  .Footer .Footer__Title{ font-size:13px !important; letter-spacing:.1em; margin-bottom:10px !important; }
  .Footer .Footer__Content, .Footer .Footer__Content a,
  .Footer .Linklist__Item, .Footer .Linklist a{ font-size:13px !important; line-height:1.7 !important; }
  .Footer .Linklist__Item{ margin:0 !important; }
  .Footer .Footer__Aside{ padding-top:14px !important; margin-top:18px !important; }
  @media (max-width:749px){
    .Footer{ padding-top:24px !important; padding-bottom:14px !important; }
    .Footer .Footer__Inner{ gap:16px !important; }
    .Footer .Footer__Content, .Footer .Linklist a, .Footer .Linklist__Item{ font-size:12.5px !important; line-height:1.85 !important; }
    .Footer .Footer__Title{ font-size:12.5px !important; margin-bottom:8px !important; }
  }

  /* --- Product card polish (collection / search / recommendations) --- */
  .ProductItem__ImageWrapper{ border-radius:12px !important; overflow:hidden; background:#F4EFE5; }
  .ProductItem__ImageWrapper, .ProductItem__Image{ transition:transform .4s ease, box-shadow .3s ease; }
  .ProductItem:hover .ProductItem__ImageWrapper{ box-shadow:0 14px 30px rgba(58,42,30,.16); }
  .ProductItem:hover .ProductItem__Image{ transform:scale(1.03); }
  .ProductItem__Title{ font-weight:600 !important; letter-spacing:-.01em; }
  .ProductItem__Label, .ProductItem__LabelList .ProductItem__Label{ background:#1F7A4D !important; color:#fff !important; border-radius:6px !important; font-weight:700; letter-spacing:.02em; }
  .Price--compareAt, .ProductItem__Price s, s.Price{ color:#9b8a76 !important; }

  /* --- Cart free-shipping progress bar --- */
  .rv-ship__msg{ margin:0 0 8px !important; font-weight:600; color:#2B1F14; }
  .rv-ship__msg span{ color:#1F7A4D; font-weight:700; }
  .rv-ship__track{ height:7px; border-radius:7px; background:#E7DDC9; overflow:hidden; }
  .rv-ship__fill{ height:100%; background:linear-gradient(90deg,#1F7A4D,#3a9c68); border-radius:7px; transition:width .45s cubic-bezier(.22,.61,.36,1); }
</style>
<script>
(function(){
  var d = document;
  function run(){
    d.documentElement.classList.add('rv-anim');
    var sel = '.rv-section h2, .rv-concern__card, .rv-card, .rv-ing__card, .rv-ugc__card, .rv-reel, .rv-cmp__col, .rv-trust__item';
    var els = [].slice.call(d.querySelectorAll(sel));
    if(!els.length) return;
    els.forEach(function(el){ el.setAttribute('data-rvr',''); });
    if(!('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('rvr-in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(!e.isIntersecting) return;
        var el = e.target;
        var sibs = [].slice.call(el.parentNode.children).filter(function(c){ return c.hasAttribute('data-rvr'); });
        var i = sibs.indexOf(el); if(i < 0) i = 0;
        el.style.transitionDelay = (Math.min(i, 6) * 70) + 'ms';
        el.classList.add('rvr-in');
        io.unobserve(el);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    els.forEach(function(el){ io.observe(el); });
  }
  if(d.readyState !== 'loading'){ run(); }
  else { d.addEventListener('DOMContentLoaded', run); }
})();
</script>
